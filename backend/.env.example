# Copie para backend/.env e preencha. Nunca faça commit do .env.

PORT=3001

# Banco local (docker compose up -d). Em produção use DATABASE_URL.
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lumen_db
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# DB_SSL=require   # disable | require | verify
# DB_SSL_CA=       # certificado da CA (com DB_SSL=verify)

GEMINI_API_KEY=
FIREBASE_PROJECT_ID=lumenm

# Origens do frontend autorizadas (CORS). Em dev, localhost:3000 já é liberado.
# CORS_ORIGINS=https://lumenm.web.app,https://lumenm.firebaseapp.com

# Limites de uso da IA por usuário (opcionais)
# LIMITE_GERACOES_HORA=15
# LIMITE_GERACOES_DIA=60
# LIMITE_CORRECOES_HORA=30
# LIMITE_REQUISICOES_IP=300

# Cadeia de modelos do Gemini (opcionais, separados por vírgula; o primeiro é o preferido)
# GEMINI_MODELOS_GERACAO=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.6-flash
# GEMINI_MODELOS_CORRECAO=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
